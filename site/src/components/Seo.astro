---
import type { Locale, AppPath } from "../lib/i18n";
import { absoluteUrl, localizedPath } from "../lib/i18n";
import { buildJsonLd } from "../lib/jsonld";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: AppPath;
  noindex?: boolean;
}

const { title, description, locale, path, noindex = false } = Astro.props;
const site = Astro.site?.toString() ?? "https://bem.fox9.dev";
const base = import.meta.env.BASE_URL;
const canonicalPath = localizedPath(locale, path);
const canonical = absoluteUrl(site, base, canonicalPath);
const zhUrl = absoluteUrl(site, base, localizedPath("zh", path));
const enUrl = absoluteUrl(site, base, localizedPath("en", path));
const homeUrl = absoluteUrl(site, base, localizedPath(locale, "/"));
const ogImage = absoluteUrl(site, base, "/og.png");
const fullTitle = path === "/" ? title : `${title} · @lai9fox/bem`;
const ogImageAlt =
  locale === "zh"
    ? "@lai9fox/bem · TypeScript BEM 类名生成器"
    : "@lai9fox/bem · Typed BEM class name generator";
const jsonLd = buildJsonLd({
  title,
  description,
  locale,
  path,
  canonical,
  homeUrl,
});
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#f5f6f3" />
<meta
  name="google-site-verification"
  content="jlaChI19Zfh3R3_z-2A30HVmim-zIDYpF_5k3O2yLik"
/>
<meta name="msvalidate.01" content="6BDE8162EB06C03F650DED2583710EE2" />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex" /> : null}
<link rel="alternate" hreflang="zh-CN" href={zhUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={zhUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="@lai9fox/bem" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
<meta
  property="og:locale:alternate"
  content={locale === "zh" ? "en_US" : "zh_CN"}
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
