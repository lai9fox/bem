{
  "name": "@lai9fox/bem",
  "version": "5.0.0",
  "description": "Typed BEM class name generator",
  "main": "dist/index.js",
  "files": [
    "dist/**"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint . --ext .ts",
    "docs:dev": "pnpm --dir site dev",
    "docs:build": "pnpm --dir site build",
    "docs:preview": "pnpm --dir site preview",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lai9fox/bem.git"
  },
  "keywords": [
    "css",
    "bem",
    "class",
    "bem generator"
  ],
  "author": "lai9fox",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lai9fox/bem/issues"
  },
  "homepage": "https://bem.fox9.dev/",
  "devDependencies": {
    "@lai9fox/eslint-config": "^2.1.2",
    "@types/jest": "^29.5.14",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  }
}
