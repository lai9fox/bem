{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "lib": [
      "ESNext",
      "dom"
    ],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": true,
    "isolatedModules": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ]
}